{
    "name":  "stata-paper-script-generator",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Stata paper script generator scaffold for web and Windows EXE.",
    "main":  "dist-electron/main.js",
    "scripts":  {
                    "dev:web":  "vite",
                    "build:web":  "vite build",
                    "build:electron":  "tsc -p tsconfig.electron.json",
                    "dev:desktop":  "npm run build:web \u0026\u0026 npm run build:electron \u0026\u0026 electron dist-electron/main.js",
                    "build":  "npm run build:web \u0026\u0026 npm run build:electron",
                    "build:desktop":  "npm run clean:desktop \u0026\u0026 npm run build \u0026\u0026 electron-builder --win",
                    "clean:desktop":  "node scripts/clean-desktop.cjs"
                },
    "dependencies":  {
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "@types/node":  "^22.13.10",
                            "@types/react":  "^18.3.18",
                            "@types/react-dom":  "^18.3.5",
                            "@vitejs/plugin-react":  "^4.3.4",
                            "electron":  "^35.0.0",
                            "electron-builder":  "^25.1.8",
                            "typescript":  "^5.8.2",
                            "vite":  "^6.2.1"
                        }
}
